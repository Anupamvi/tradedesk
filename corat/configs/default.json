{
  "schema_version": "corat.config.v1",
  "universe_file": "configs/universe.csv",
  "output_root": "out",
  "cache_root": "var/cache",
  "state_root": "var/state",
  "lookback_calendar_days": 1900,
  "max_final_ideas": 10,
  "max_enriched_candidates": 20,
  "max_option_candidates": 15,
  "discovery": {
    "dynamic_orats_universe": true,
    "maximum_equities": 500,
    "minimum_market_cap_thousands": 2000000,
    "market_cap_slots": 350,
    "option_volume_slots": 125,
    "stock_volume_slots": 125
  },
  "orats": {
    "base_url": "https://api.orats.io/datav2",
    "request_timeout_seconds": 120,
    "max_requests_per_run": 600,
    "monthly_request_cap": 20000,
    "batch_size": 10,
    "requests_per_minute": 90,
    "min_dte": 21,
    "max_dte": 75
  },
  "schwab": {
    "enabled": false,
    "env_file": "/Users/anuppamvi/tradedesk/.env",
    "market_data_base_url": "https://api.schwabapi.com/marketdata/v1",
    "request_timeout_seconds": 30,
    "quote_batch_size": 50,
    "maximum_quote_age_minutes": 30,
    "refresh_access_token": false
  },
  "liquidity": {
    "minimum_stock_price": 5.0,
    "minimum_average_dollar_volume": 25000000,
    "minimum_option_open_interest": 0,
    "minimum_option_volume": 0,
    "maximum_option_spread_pct": 1.0
  },
  "risk": {
    "portfolio_nav": null,
    "normal_risk_pct": 0.0075,
    "maximum_high_conviction_risk_pct": 0.0125,
    "minimum_reward_risk": 1.7,
    "preferred_reward_risk": 2.0,
    "maximum_correlated_ideas": 2
  },
  "history": {
    "minimum_analog_sample": 20,
    "maximum_analog_sample": 200,
    "signal_spacing_sessions": 10,
    "primary_horizon_sessions": 10,
    "forward_horizons": [1, 3, 5, 10, 20]
  },
  "actionability": {
    "minimum_score": 75,
    "maximum_price_age_minutes": 30,
    "require_catalyst_evidence": true,
    "require_historical_evidence": true,
    "require_earnings_date_for_options": true
  },
  "execution": {
    "commission_per_contract": 0.65
  },
  "research": {
    "lookback_days": 21,
    "request_timeout_seconds": 15
  },
  "regime": {
    "benchmarks": ["SPY", "QQQ", "IWM", "DIA"],
    "macro_proxies": ["VIX", "TLT", "UUP", "HYG", "GLD"],
    "sector_etfs": ["XLK", "XLC", "XLY", "XLP", "XLE", "XLF", "XLV", "XLI", "XLB", "XLRE", "XLU", "SMH", "IGV", "CIBR", "ITA", "XBI", "URA", "BOTZ", "CLOU"]
  }
}
