[Unit]
Description=Run UW Trade Monitor during market and after-hours watch windows

[Timer]
# Poll every 5 minutes on weekdays. The Python monitor skips outside market
# hours unless after-hours movement gates pass, so this calendar stays simple.
OnCalendar=Mon..Fri *-*-* *:0/5:00 America/New_York
Persistent=true
RandomizedDelaySec=20
Unit=trade-monitor.service

[Install]
WantedBy=timers.target
